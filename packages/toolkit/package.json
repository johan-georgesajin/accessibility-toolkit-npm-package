{
  "name": "accessibility-toolkit",
  "version": "1.0.0",
  "description": "A React accessibility toolkit with visual controls, reading tools, modes, and WCAG developer checks.",
  "type": "module",
  "sideEffects": [
    "./dist/index.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
