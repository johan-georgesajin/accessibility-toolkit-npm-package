{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@a11y-toolkit/core": ["packages/core/src"],
      "@a11y-toolkit/reading": ["packages/reading/src"],
      "@a11y-toolkit/visual": ["packages/visual/src"],
      "@a11y-toolkit/modes": ["packages/modes/src"],
      "@a11y-toolkit/devtools": ["packages/devtools/src"]
    },
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
